# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# A broadcast folder with transactions and zero receipts is a run that never
# landed. Committing one publishes a deployment that did not happen, which is
# the single claim this repo cannot afford to make by accident. Real broadcasts
# are added deliberately, by path, once their receipts exist.
/broadcast/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example

# Agent Skills installed locally (whitechain-dev). Re-install with:
#   npx skills add whitechain-labs/skills --skill whitechain-dev
.agents/
.claude/
skills-lock.json

# Foundry lockfile is environment-specific here
foundry.lock
